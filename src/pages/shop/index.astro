---
import BaseLayout from "../../layouts/BaseLayout.astro"

const items = [
  {
    code: "SHCH–D01",
    title: "Полевые заметки об онлайн-ритейле",
    description: "Цифровое издание — готовится к выпуску",
  },
  {
    code: "SHCH–T01",
    title: "Набор инструментов для продуктовой команды",
    description:
      "Шаблоны для исследований и продуктовых решений — в разработке",
  },
  {
    code: "SHCH–O01",
    title: "Объекты SHCH",
    description: "Печатные и рабочие вещи небольшими тиражами — скоро",
  },
]
---

<BaseLayout
  title="Магазин"
  description="Собственные инструменты, цифровые издания и небольшие тиражи SHCH"
>
  <section class="legacy-split legacy-list-page legacy-shop-page">
    <div class="legacy-panel legacy-list-page__main">
      <header class="legacy-page-title">
        <a class="legacy-back" href="/">INDEX ←</a>
        <h1>МАГАЗИН</h1>
      </header>
      <p class="legacy-intro">
        Собственные инструменты, цифровые издания и небольшие тиражи.
      </p>
      <div class="legacy-shop-list">
        {
          items.map(item => (
            <article class="legacy-shop-row">
              <span>{item.code}</span>
              <h2>{item.title}</h2>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
    <aside class="legacy-panel legacy-shop-contact">
      <p>Первый выпуск готовится.</p>
      <p>
        <a href="mailto:goto@shch.one?subject=SHCH%20Shop">
          Написать о магазине →
        </a>
      </p>
    </aside>
  </section>
</BaseLayout>
