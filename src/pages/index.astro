---
import { getImage } from "astro:assets"
import { getCollection } from "astro:content"

import About from "../components/About.astro"
import shchMark from "../images/shch-ico.png"
import BaseLayout from "../layouts/BaseLayout.astro"
import { byOrder, isPublished, isRussian } from "../lib/content"

const projects = (await getCollection("site"))
  .filter(
    entry =>
      isPublished(entry) && isRussian(entry) && entry.data.type === "project",
  )
  .sort(byOrder)

const preparedProjects = await Promise.all(
  projects.map(async project => ({
    project,
    preview: project.data.cover
      ? await getImage({
          src: project.data.cover,
          width: 1200,
          quality: 86,
          format: "webp",
        })
      : undefined,
  })),
)

const initialProject = preparedProjects[0]
---

<BaseLayout title="Студия SHCH">
  <section class="legacy-logo" aria-label="SHCH">
    <img src={shchMark.src} width="111" height="106" alt="SHCH" />
  </section>

  <section class="legacy-split legacy-about">
    <div class="legacy-panel legacy-panel--left">
      <header class="legacy-title-block">
        <h1>О НАС</h1>
      </header>
      <About />
    </div>
    <div class="legacy-panel legacy-panel--empty" aria-hidden="true"></div>
  </section>

  <section class="legacy-split legacy-projects" id="projects">
    <div class="legacy-panel legacy-panel--left">
      <header class="legacy-title-block legacy-title-block--projects">
        <h1>ПРОЕКТЫ</h1>
      </header>
      <p class="legacy-intro">
        Список наших избранных проектов. Названия кликабельны. Внутри могут быть
        дополнительные фотографии и комментарий.
      </p>
      <div class="legacy-project-list">
        {
          preparedProjects.map(({ project, preview }) => (
            <a
              class="legacy-project-row"
              href={`/projects/${project.data.slug}/`}
              data-project-preview
              data-image={preview?.src}
              data-title={project.data.title}
              data-credits={project.data.credits || ""}
            >
              <span>{project.data.title}</span>
              <span>{project.data.year}</span>
              <span>{project.data.object}</span>
            </a>
          ))
        }
      </div>
      <nav class="legacy-secondary-nav" aria-label="Дополнительные разделы">
        <a href="/notes/">ЗАПИСИ →</a>
        <a href="/shop/">МАГАЗИН →</a>
      </nav>
    </div>

    <aside class="legacy-panel legacy-preview" aria-live="polite">
      <div class="legacy-preview__media">
        {
          initialProject?.preview && (
            <img
              src={initialProject.preview.src}
              alt=""
              data-preview-image
              width={initialProject.preview.attributes.width}
              height={initialProject.preview.attributes.height}
            />
          )
        }
      </div>
      <p class="legacy-preview__caption" data-preview-caption>
        {
          initialProject?.project.data.credits
            ? `Фото: ${initialProject.project.data.title} — ${initialProject.project.data.credits}`
            : ""
        }
      </p>
    </aside>
  </section>
</BaseLayout>

<script>
  const rows = Array.from(
    document.querySelectorAll<HTMLElement>("[data-project-preview]"),
  )
  const image = document.querySelector<HTMLImageElement>("[data-preview-image]")
  const caption = document.querySelector<HTMLElement>("[data-preview-caption]")
  let delay: number | undefined

  const showProject = (row: HTMLElement) => {
    const source = row.dataset.image
    if (!image || !source) return

    image.src = source
    image.alt = ""
    if (caption) {
      const credits = row.dataset.credits
      caption.textContent = credits
        ? `Фото: ${row.dataset.title} — ${credits}`
        : ""
    }
  }

  const scheduleProject = (row: HTMLElement) => {
    window.clearTimeout(delay)
    delay = window.setTimeout(() => showProject(row), 250)
  }

  rows.forEach(row => {
    row.addEventListener("mouseenter", () => scheduleProject(row))
    row.addEventListener("focus", () => scheduleProject(row))
  })

  if (rows.length > 1) {
    showProject(rows[Math.floor(Math.random() * rows.length)])
  }
</script>
