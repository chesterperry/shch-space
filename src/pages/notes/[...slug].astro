---
import { Image } from "astro:assets"
import { getCollection, render } from "astro:content"

import IconArrow from "../../components/IconArrow.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { isPublished, isRussian } from "../../lib/content"

export async function getStaticPaths() {
  const notes = (await getCollection("site")).filter(
    entry =>
      isPublished(entry) && isRussian(entry) && entry.data.type === "note",
  )

  return notes.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  canonicalPath={`/notes/${entry.data.slug}/`}
  lang={entry.data.locale}
>
  <header class="article-header journal-hero">
    <div>
      <a class="section-index" href="/notes/">
        <IconArrow direction="left" /> Блокнот
      </a>
    </div>
    <h1>{entry.data.title}</h1>
  </header>
  {
    entry.data.cover && (
      <section class="article-cover">
        <Image
          src={entry.data.cover}
          alt=""
          class="content-cover-image"
          quality={90}
        />
      </section>
    )
  }
  <article class="article-layout journal-post">
    <span class="section-index">Запись / SHCH</span>
    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>
