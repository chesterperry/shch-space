---
import { Image } from "astro:assets"
import { getCollection, render } from "astro:content"

import BaseLayout from "../../layouts/BaseLayout.astro"
import { isPublished, isRussian } from "../../lib/content"

export async function getStaticPaths() {
  const notes = (await getCollection("site")).filter(
    entry =>
      isPublished(entry) && isRussian(entry) && entry.data.type === "note",
  )

  return notes.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  canonicalPath={`/notes/${entry.data.slug}/`}
  lang={entry.data.locale}
>
  <article class="legacy-article">
    <header class="legacy-page-title legacy-article__title">
      <a class="legacy-back" href="/notes/">ЗАПИСИ ←</a>
      <h1>{entry.data.title}</h1>
    </header>
    {
      entry.data.cover && (
        <figure class="legacy-article__cover">
          <Image
            src={entry.data.cover}
            alt=""
            class="legacy-article__cover-image"
            quality={90}
          />
        </figure>
      )
    }
    <div class="legacy-richtext">
      <Content />
    </div>
  </article>
</BaseLayout>
