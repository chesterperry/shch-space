---
import { Image } from "astro:assets"
import { getCollection, render } from "astro:content"

import BaseLayout from "../../layouts/BaseLayout.astro"
import { byOrder, isPublished, isRussian } from "../../lib/content"

export async function getStaticPaths() {
  const projects = (await getCollection("site"))
    .filter(
      entry =>
        isPublished(entry) && isRussian(entry) && entry.data.type === "project",
    )
    .sort(byOrder)

  return projects.flatMap((entry, index) =>
    [entry.data.slug, ...entry.data.aliases].map(slug => ({
      params: { slug },
      props: {
        entry,
        previous: index > 0 ? projects[index - 1] : undefined,
        next: index < projects.length - 1 ? projects[index + 1] : undefined,
      },
    })),
  )
}

const { entry, previous, next } = Astro.props
const { Content } = await render(entry)
const project = entry.data
const externalLabel = project.externalUrl
  ? new URL(project.externalUrl).hostname.replace(/^www\./, "")
  : undefined
---

<BaseLayout
  title={project.title}
  description={project.summary}
  canonicalPath={`/projects/${project.slug}/`}
  lang={project.locale}
>
  <section class="legacy-split legacy-project-page">
    <article class="legacy-panel legacy-project-page__main">
      <header class="legacy-page-title legacy-project-page__title">
        <a class="legacy-back" href="/#projects">INDEX ←</a>
        <h1>{project.title}</h1>
      </header>

      <div class="legacy-facts" aria-label="Информация о проекте">
        {
          project.year && (
            <div class="legacy-fact">
              <h2>ПЕРИОД</h2>
              <hr />
              <p>{project.year}</p>
            </div>
          )
        }
        {
          project.role && (
            <div class="legacy-fact">
              <h2>РОЛЬ</h2>
              <hr />
              <p>{project.role}</p>
            </div>
          )
        }
        {
          project.object && (
            <div class="legacy-fact">
              <h2>ТИП</h2>
              <hr />
              <p>{project.object}</p>
            </div>
          )
        }
        {
          project.externalUrl && (
            <div class="legacy-fact">
              <h2>ССЫЛКА ↗</h2>
              <hr />
              <p>
                <a href={project.externalUrl}>{externalLabel}</a>
              </p>
            </div>
          )
        }
        {
          project.stack.length > 0 && (
            <div class="legacy-fact legacy-fact--wide">
              <h2>СТЕК</h2>
              <hr />
              <p>{project.stack.join(" / ")}</p>
            </div>
          )
        }
      </div>

      {
        project.cover && (
          <figure class="legacy-project-mobile-media">
            <Image src={project.cover} alt="" quality={90} />
            {project.credits && <figcaption>{project.credits}</figcaption>}
          </figure>
        )
      }

      <section class="legacy-project-comment">
        <h2>КОММЕНТАРИЙ</h2>
        <hr />
        <div class="legacy-richtext">
          <Content />
        </div>
      </section>

      <nav class="legacy-mobile-pagination" aria-label="Другие проекты">
        {
          previous ? (
            <a href={`/projects/${previous.data.slug}/`}>← ПРЕДЫДУЩИЙ</a>
          ) : (
            <span />
          )
        }
        {next && <a href={`/projects/${next.data.slug}/`}>СЛЕДУЮЩИЙ →</a>}
      </nav>
    </article>

    <aside class="legacy-panel legacy-project-page__media">
      <nav class="legacy-project-pagination" aria-label="Другие проекты">
        <span>
          {
            previous && (
              <a href={`/projects/${previous.data.slug}/`}>
                ← {previous.data.title}
              </a>
            )
          }
        </span>
        <span>
          {
            next && (
              <a href={`/projects/${next.data.slug}/`}>{next.data.title} →</a>
            )
          }
        </span>
      </nav>
      {
        project.cover && (
          <figure class="legacy-project-cover">
            <Image src={project.cover} alt="" quality={90} />
            {project.credits && (
              <figcaption>
                Фото: {project.title} — {project.credits}
              </figcaption>
            )}
          </figure>
        )
      }
    </aside>
  </section>
</BaseLayout>
