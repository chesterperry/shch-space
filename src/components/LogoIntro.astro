<div class="logo-intro" data-logo-intro aria-hidden="true">
  <div class="logo-intro__mark"></div>
</div>

<script>
  const INTRO_DURATION = 1440
  const INTRO_VARIATION_KEY = "shch-intro-variation"
  const INTRO_SCALE_MIN = 0.3
  const INTRO_SCALE_MAX = 1
  const INTRO_VARIATIONS = [
    { x: -0.95, y: 0, rotate: 0 },
    { x: 0.5, y: -0.5, rotate: -2.2 },
    { x: -1.8, y: 0.65, rotate: 1.8 },
    { x: 0.9, y: 0.9, rotate: 2.6 },
    { x: -2.4, y: -0.8, rotate: -1.4 },
  ]

  const pickVariation = () => {
    let previous = -1

    try {
      previous = Number.parseInt(
        window.sessionStorage.getItem(INTRO_VARIATION_KEY) || "-1",
        10,
      )
    } catch {
      previous = -1
    }

    const available = INTRO_VARIATIONS.map((_, index) => index).filter(
      index => index !== previous,
    )
    const variation =
      available[Math.floor(Math.random() * available.length)] ?? 0

    try {
      window.sessionStorage.setItem(INTRO_VARIATION_KEY, String(variation))
    } catch {
      // The animation can still run when storage is unavailable.
    }

    return variation
  }

  const overlay = document.querySelector<HTMLElement>("[data-logo-intro]")
  const mark = overlay?.querySelector<HTMLElement>(".logo-intro__mark")
  const target = document.querySelector<HTMLElement>("[data-site-mark]")
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches

  const finishIntro = () => {
    document.documentElement.classList.remove("logo-intro-running")
    overlay?.remove()
  }

  if (!overlay || !mark || !target || reduceMotion || !mark.animate) {
    finishIntro()
  } else {
    const variationIndex = pickVariation()
    const variation = INTRO_VARIATIONS[variationIndex] ?? INTRO_VARIATIONS[0]
    const scaleVariation =
      INTRO_SCALE_MIN + Math.random() * (INTRO_SCALE_MAX - INTRO_SCALE_MIN)
    const targetRect = target.getBoundingClientRect()
    const scale =
      Math.max(
        window.innerWidth / targetRect.width,
        window.innerHeight / targetRect.height,
      ) *
      26 *
      scaleVariation
    const initialWidth = targetRect.width * scale
    const initialHeight = targetRect.height * scale
    const initialLeft =
      window.innerWidth / 2 - initialWidth / 2 + window.innerWidth * variation.x
    const initialTop =
      window.innerHeight / 2 -
      initialHeight / 2 +
      window.innerHeight * variation.y

    overlay.dataset.variation = String(variationIndex)
    overlay.dataset.scale = scaleVariation.toFixed(3)
    mark.style.setProperty(
      "-webkit-mask-size",
      `${initialWidth}px ${initialHeight}px`,
    )
    mark.style.maskSize = `${initialWidth}px ${initialHeight}px`
    mark.style.setProperty(
      "-webkit-mask-position",
      `${initialLeft}px ${initialTop}px`,
    )
    mark.style.maskPosition = `${initialLeft}px ${initialTop}px`
    mark.style.transform = `rotate(${variation.rotate}deg) scale(1.08)`
    overlay.style.backgroundColor = "#f2f0e8"
    document.documentElement.classList.add("logo-intro-running")

    const markAnimation = mark.animate(
      [
        { opacity: 1, offset: 0 },
        { opacity: 1, offset: 0.32 },
        { opacity: 0, offset: 0.57 },
        { opacity: 0, offset: 1 },
      ],
      {
        duration: INTRO_DURATION,
        easing: "cubic-bezier(0.65, 0, 0.35, 1)",
        fill: "forwards",
      },
    )

    const overlayAnimation = overlay.animate(
      [
        { opacity: 1, offset: 0 },
        { opacity: 1, offset: 0.6 },
        { opacity: 0, offset: 1 },
      ],
      {
        duration: INTRO_DURATION,
        easing: "cubic-bezier(0.55, 0, 0.2, 1)",
        fill: "forwards",
      },
    )

    window.setTimeout(finishIntro, INTRO_DURATION + 120)
    Promise.allSettled([
      markAnimation.finished,
      overlayAnimation.finished,
    ]).then(finishIntro)
  }
</script>
