---
interface Props {
  direction?: "down" | "left" | "outward" | "right"
  class?: string
}

const { direction = "outward", class: className = "" } = Astro.props
---

<span
  class:list={["icon-arrow", `icon-arrow--${direction}`, className]}
  aria-hidden="true"
>
  <svg viewBox="0 -960 960 960" focusable="false">
    <path
      d="M245.391-232.109 186.5-291 586-690.5H236.891v-83h491v491h-83v-349.108l-399.5 399.499Z"
    ></path>
  </svg>
</span>
