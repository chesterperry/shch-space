{
  "name": "oleg-space",
  "private": true,
  "description": "Static SHCH portfolio, projects and notebook built with Astro",
  "version": "0.1.0",
  "author": "Oleg Scherbinin <oleg.shch@gmail.com>",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "astro": "^7.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.2.4",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "astro"
  ],
  "license": "0BSD",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "content:sync": "node scripts/sync-content.mjs",
    "dev": "astro dev",
    "develop": "astro dev",
    "format": "prettier --write \"**/*.{astro,js,jsx,ts,tsx,json,md,mdx,css}\"",
    "preview": "astro preview",
    "release:prepare": "pnpm content:sync && pnpm check && pnpm build",
    "start": "astro dev",
    "test": "astro check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.7",
      "postcss-selector-parser@6.1.2": "6.1.4"
    }
  }
}
